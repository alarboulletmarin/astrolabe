pkgbase = astrolabe
	pkgdesc = Desktop journal of your sport activities, read from your Garmin account
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/alarboulletmarin/astrolabe
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = fontconfig
	makedepends = freetype2
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	optdepends = vulkan-driver: a Vulkan driver for your GPU is required to open the window
	optdepends = gnome-keyring: where the Garmin key is kept (or kwallet, keepassxc); without one, an encrypted file is used
	options = !debug
	source = astrolabe-0.1.0.tar.gz::https://github.com/alarboulletmarin/astrolabe/archive/refs/tags/v0.1.0.tar.gz
